{
  "functions": {
    "api/blog.js": {
      "includeFiles": "blog/**"
    },
    "api/views.js": {
      "includeFiles": "blog/**"
    },
    "api/en.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    { "source": "/en", "destination": "/api/en" },
    { "source": "/en/", "destination": "/api/en" },
    { "source": "/now", "destination": "/api/blog?page=now" },
    { "source": "/now/", "destination": "/api/blog?page=now" },
    { "source": "/uses", "destination": "/api/blog?page=uses" },
    { "source": "/uses/", "destination": "/api/blog?page=uses" },
    { "source": "/colophon", "destination": "/api/blog?page=colophon" },
    { "source": "/colophon/", "destination": "/api/blog?page=colophon" },
    { "source": "/blog/rss.xml", "destination": "/api/blog?format=rss" },
    { "source": "/blog/tag", "destination": "/api/blog?page=tags" },
    { "source": "/blog/tag/", "destination": "/api/blog?page=tags" },
    { "source": "/blog/tag/:tag", "destination": "/api/blog?tag=:tag" },
    { "source": "/blog/tag/:tag/", "destination": "/api/blog?tag=:tag" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/blog/:slug/", "destination": "/api/blog?slug=:slug" }
  ]
}
